{
  "name": "web",
  "private": true,
  "version": "0.9.8",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:analyze": "VITE_ANALYZE=true npm run build",
    "build:docker": "vite build",
    "build:desktop": "npm run build && npm run desktop:build && npm run desktop:stage",
    "build:themes": "tsx src/themes/build-themes.ts",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "lint:file-size": "node scripts/check-file-size-ratchet.mjs",
    "lint:file-size:update": "node scripts/check-file-size-ratchet.mjs --update",
    "lint:i18n-agent": "node scripts/check-agent-i18n-hardcoded.mjs",
    "i18n:types": "node scripts/generate-i18n-types.mjs",
    "check:i18n-types": "node scripts/generate-i18n-types.mjs --check",
    "i18n:review": "node scripts/generate-i18n-types.mjs --review",
    "lint": "eslint src",
    "lint:all": "eslint .",
    "lint:desktop": "eslint desktop",
    "lint:typed": "ESLINT_TYPED=true eslint src/lib/agent.ts src/pages/agent/operators src/pages/agent/adapters",
    "postinstall": "patch-package",
    "prepare": "husky",
    "desktop:build": "node desktop/build/build-electron.mjs",
    "desktop:stage": "node desktop/build/stage.mjs",
    "desktop:verify:stage": "node desktop/build/verify-stage.mjs",
    "desktop:package:dir": "node desktop/build/package-electron.mjs",
    "desktop:verify:package": "node desktop/build/verify-package.mjs",
    "desktop:typecheck": "tsc -p desktop/tsconfig.main.json && tsc -p desktop/tsconfig.preload.json",
    "verify:test-inventory": "node scripts/test-inventory.mjs",
    "test:unit": "node scripts/run-test-suite.mjs unit",
    "test:ci": "node scripts/run-test-suite.mjs ci",
    "test:browser": "node scripts/browser/verify-ai-workspace.mjs",
    "test:browser:production": "node scripts/browser/verify-ai-workspace.mjs --production",
    "profile:routes": "node scripts/profile-route-bundles.mjs",
    "test:client-platform": "vitest run src/entrypoints/__tests__/*.test.ts src/entrypoints/__tests__/*.test.tsx src/platform/__tests__/*.test.tsx src/lib/commands/__tests__/*.test.ts src/lib/commands/__tests__/*.test.tsx src/pages/auth/__tests__/*.test.tsx src/components/layout/desktop/__tests__/*.test.tsx",
    "test:desktop": "tsx --test desktop/tests/**/*.test.ts desktop/tests/**/*.test.mjs",
    "typecheck:agent-strict": "tsc -p tsconfig.agent-strict.json",
    "test:agent-t1": "tsx --tsconfig tsconfig.app.json --test src/pages/agent/operators/__tests__/serializers.test.ts src/pages/agent/adapters/__tests__/adapters.test.ts src/pages/agent/form/__tests__/t3-parity-normalizers.test.ts src/pages/agent/setting-dialog/__tests__/settings-payload.test.ts src/pages/agent/features/runtime-workbench/__tests__/runtime-lifecycle.test.ts",
    "test:design-tokens": "tsx --tsconfig tsconfig.app.json --test src/lib/design-tokens/__tests__/*.ts",
    "test:streaming": "tsx --tsconfig tsconfig.app.json --test src/lib/streaming/__tests__/*.ts && vitest run src/components/chat/__tests__/streaming-x-markdown.test.tsx",
    "test:api": "tsx --tsconfig tsconfig.app.json --test src/api/__tests__/*.ts",
    "test:product-ui": "tsx --tsconfig tsconfig.app.json --test src/pages/settings/__tests__/api-keys-capabilities.test.ts && vitest run src/hooks/__tests__/use-agent-mutation.test.tsx src/pages/agent/setting-dialog/__tests__/setting-dialog.test.tsx src/pages/home/components/__tests__/eng-6-capabilities.test.tsx src/pages/studio/create-app/components/__tests__/editor-header.test.tsx src/pages/search/detail/components/__tests__/search-detail-header.test.tsx src/pages/search/detail/export/__tests__/search-session-export.test.ts src/pages/error/__tests__/route-recovery.test.tsx",
    "test:security": "node --test eslint-rules/__tests__/*.test.mjs && vitest run src/lib/__tests__/toast.test.tsx",
    "preview": "vite preview"
  },
  "browserslist": [
    "Chrome >= 111",
    "Edge >= 111",
    "Firefox >= 128",
    "Safari >= 16.4"
  ],
  "lint-staged": {
    "*.{js,mjs,jsx,ts,tsx,json,css,md}": "prettier --write",
    "src/**/*.{ts,tsx}": "eslint",
    "desktop/**/*.{mjs,ts,tsx}": "eslint"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@ant-design/x": "2.10.0",
    "@ant-design/x-card": "2.10.0",
