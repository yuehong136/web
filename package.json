  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:analyze": "VITE_ANALYZE=true npm run build",
    "build:docker": "vite build",
    "build:themes": "tsx src/themes/build-themes.ts",
    "lint": "eslint src",
