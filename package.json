    "lint:typed": "ESLINT_TYPED=true eslint src/lib/agent.ts src/pages/agent/operators src/pages/agent/adapters",
    "postinstall": "patch-package",
    "prepare": "husky",
    "typecheck:agent-strict": "tsc -p tsconfig.agent-strict.json",
    "test:agent-t1": "tsx --tsconfig tsconfig.app.json --test src/pages/agent/operators/__tests__/serializers.test.ts src/pages/agent/adapters/__tests__/adapters.test.ts",
    "preview": "vite preview"
  },
  "browserslist": [
    "Chrome >= 107",
    "Edge >= 107",
    "Firefox >= 104",
    "Safari >= 16"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": "prettier --write",
    "src/**/*.{ts,tsx}": "eslint"
