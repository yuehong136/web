    "@hookform/resolvers": "^7.0.6",
    "@js-preview/excel": "^1.7.14",
    "@lexical/plain-text": "0.53.0",
    "@lexical/react": "0.53.0",
    "@lexical/rich-text": "0.53.0",
    "@lexical/utils": "0.53.0",
    "@lobehub/icons-static-svg": "1.102.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-devtools": "5.107.1",
    "@types/lodash": "^4.17.27",
    "@types/papaparse": "^5.5.2",
    "@uiw/react-md-editor": "^4.2.3",
    "@xyflow/react": "^12.12.1",
    "antd": "6.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.18",
    "echarts": "^6.1.0",
    "embla-carousel-react": "^8.6.0",
    "eventsource-parser": "^4.1.3",
    "human-id": "^4.2.2",
    "i18next": "27.1.3",
    "i18next-browser-languagedetector": "^8.3.0",
    "immer": "^11.2.10",
    "jsencrypt": "^3.5.4",
    "lexical": "0.53.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.73.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^11.17.2",
    "motion": "14.14.0",
    "papaparse": "^5.7.1",
    "pptx-preview": "^1.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "^20.2.0",
    "react-hook-form": "^7.92.0",
    "react-i18next": "18.0.2",
    "react-markdown": "^10.1.0",
    "react-pdf-highlighter": "^8.0.0-rc.0",
    "react-photo-view": "^1.2.7",
    "react-resizable-panels": "4.24.0",
    "react-router-dom": "^7.18.5",
    "react-shiki": "^0.11.3",
    "recharts": "^3.10.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.5",
    "use-stick-to-bottom": "1.1.6",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@electron/asar": "4.3.2",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@tailwindcss/node": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.1",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "file:vendor/eslint-plugin-jsx-a11y-6.10.2-web.1.tgz",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "eslint-plugin-tailwindcss": "4.4.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "patch-package": "^8.0.1",
    "playwright": "1.65.1",
    "prettier": "~3.8.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rolldown": "1.3.2",
    "rollup-plugin-visualizer": "^7.1.3",
    "tailwind-scrollbar": "4.0.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.2",
